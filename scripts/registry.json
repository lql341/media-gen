{
  "version": 1,
  "comment": "模型能力表：按 id 模式匹配，判定 kind（image/video/speech/transcription）与约束。用户可用 ~/.config/media-gen/registry.json 覆盖或补充（同名 match 以用户为准）。协议（openai / azure / ark / dashscope / minimax / custom / command）由配置档决定，不在这里绑定。",
  "rules": [
    {
      "match": [
        "doubao-seedance-*",
        "seedance-*"
      ],
      "kind": "video",
      "duration": {
        "min": 4,
        "max": 30,
        "auto": -1
      },
      "size": {
        "form": "WxH",
        "fallback": "ratio+resolution",
        "resolutions": [
          "480p",
          "720p",
          "1080p"
        ]
      },
      "image_input": true,
      "notes": "火山 Seedance；LiteLLM 上走 /videos，size 被拒时回退 extra_body.ratio + resolution"
    },
    {
      "match": [
        "doubao-seedream-*",
        "seedream-*"
      ],
      "kind": "image",
      "size": {
        "form": "WxH"
      },
      "n": true,
      "image_input": true,
      "notes": "火山 Seedream 文生图/图生图"
    },
    {
      "match": [
        "wan*-t2v*",
        "wan*-i2v*",
        "wanx*-t2v*",
        "wan*-video*"
      ],
      "kind": "video",
      "duration": {
        "min": 2,
        "max": 10,
        "auto": -1
      },
      "size": {
        "form": "W*H",
        "resolutions": [
          "480P",
          "720P",
          "1080P"
        ]
      },
      "image_input": true,
      "notes": "阿里云百炼 Wan 视频；原生 API 尺寸用 1280*720 语法"
    },
    {
      "match": [
        "wan*-t2i*",
        "wanx*-t2i*",
        "wan*-image*"
      ],
      "kind": "image",
      "size": {
        "form": "W*H"
      },
      "n": true,
      "notes": "阿里云百炼 Wan 文生图"
    },
    {
      "match": [
        "MiniMax-Hailuo-*",
        "T2V-01*",
        "I2V-01*",
        "MiniMax-video*"
      ],
      "kind": "video",
      "duration": {
        "enum": [
          6,
          10
        ]
      },
      "size": {
        "form": "resolution",
        "resolutions": [
          "768P",
          "1080P"
        ]
      },
      "image_input": true,
      "notes": "MiniMax Hailuo；时长是枚举 6/10 秒，分辨率用 768P/1080P"
    },
    {
      "match": [
        "image-01*",
        "MiniMax-image*"
      ],
      "kind": "image",
      "size": {
        "form": "aspect",
        "aspects": [
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4"
        ]
      },
      "n": true,
      "notes": "MiniMax 文生图；用 aspect_ratio 而不是像素尺寸"
    },
    {
      "match": [
        "gpt-image-*",
        "dall-e-*",
        "flux*",
        "stable-diffusion*",
        "sd3*",
        "sdxl*",
        "imagen*"
      ],
      "kind": "image",
      "size": {
        "form": "WxH"
      },
      "n": true,
      "notes": "OpenAI 兼容文生图"
    },
    {
      "match": [
        "gpt-4o-mini-tts*",
        "tts-1*",
        "speech-*",
        "cosyvoice*"
      ],
      "kind": "speech",
      "notes": "语音合成（POST /audio/speech，返回音频字节）"
    },
    {
      "match": [
        "whisper-*",
        "gpt-4o-transcribe*",
        "gpt-4o-mini-transcribe*",
        "paraformer*"
      ],
      "kind": "transcription",
      "notes": "语音转写（POST /audio/transcriptions，multipart 上传音频，返回 text）"
    },
    {
      "match": [
        "sora*",
        "veo*",
        "kling*",
        "pixverse*",
        "hunyuan-video*",
        "cogvideo*"
      ],
      "kind": "video",
      "duration": {
        "min": 1,
        "max": 20
      },
      "size": {
        "form": "WxH"
      },
      "image_input": true,
      "notes": "通用视频模型；具体约束以服务端报错为准"
    },
    {
      "match": [
        "kling*",
        "klingai*"
      ],
      "kind": "video",
      "duration": {
        "enum": [
          5,
          10
        ]
      },
      "size": {
        "form": "aspect",
        "aspects": [
          "16:9",
          "9:16",
          "1:1"
        ]
      },
      "image_input": true,
      "notes": "快手可灵；时长枚举 5/10s，比例维度"
    },
    {
      "match": [
        "luma*",
        "ray-2*",
        "ray-flash*",
        "dream-machine*"
      ],
      "kind": "video",
      "duration": {
        "min": 5,
        "max": 10
      },
      "size": {
        "form": "aspect",
        "aspects": [
          "16:9",
          "9:16",
          "1:1",
          "4:3",
          "3:4"
        ]
      },
      "image_input": true,
      "notes": "Luma Dream Machine"
    },
    {
      "match": [
        "runway*",
        "gen-3*",
        "gen-4*",
        "gen4_turbo*"
      ],
      "kind": "video",
      "duration": {
        "enum": [
          5,
          10
        ]
      },
      "size": {
        "form": "aspect",
        "aspects": [
          "16:9",
          "9:16",
          "1:1"
        ]
      },
      "image_input": true,
      "notes": "Runway Gen-3/Gen-4"
    },
    {
      "match": [
        "pika*",
        "pika-2*"
      ],
      "kind": "video",
      "duration": {
        "enum": [
          3,
          5
        ]
      },
      "size": {
        "form": "aspect",
        "aspects": [
          "16:9",
          "9:16",
          "1:1"
        ]
      },
      "image_input": true,
      "notes": "Pika"
    },
    {
      "match": [
        "sora-2*",
        "sora-1*"
      ],
      "kind": "video",
      "duration": {
        "enum": [
          4,
          8,
          12
        ]
      },
      "size": {
        "form": "WxH"
      },
      "image_input": true,
      "notes": "OpenAI Sora 2（时长枚举）"
    },
    {
      "match": [
        "imagen*",
        "gemini-2.5-flash-image*",
        "gemini-3*-image*"
      ],
      "kind": "image",
      "size": {
        "form": "aspect",
        "aspects": [
          "1:1",
          "3:4",
          "4:3",
          "9:16",
          "16:9"
        ]
      },
      "n": true,
      "image_input": true,
      "notes": "Google Imagen / Gemini 图像模型；比例维度"
    },
    {
      "match": [
        "veo-3*",
        "veo-2*",
        "veo*"
      ],
      "kind": "video",
      "duration": {
        "enum": [
          4,
          6,
          8
        ]
      },
      "size": {
        "form": "resolution",
        "resolutions": [
          "720p",
          "1080p"
        ]
      },
      "image_input": true,
      "notes": "Google Veo"
    },
    {
      "match": [
        "flux*",
        "bfl-*"
      ],
      "kind": "image",
      "size": {
        "form": "WxH"
      },
      "n": true,
      "image_input": true,
      "notes": "Black Forest Labs FLUX（含 img2img 变体）"
    },
    {
      "match": [
        "sdxl*",
        "sd-*",
        "stable-image*",
        "core*"
      ],
      "kind": "image",
      "size": {
        "form": "WxH"
      },
      "n": true,
      "image_input": true,
      "notes": "Stability SD / Stable Image Core"
    },
    {
      "match": [
        "recraft*",
        "ideogram*",
        "lfm-*",
        "kolors*",
        "cogview*",
        "hunyuan-image*",
        "seedream-*"
      ],
      "kind": "image",
      "size": {
        "form": "WxH"
      },
      "n": true,
      "notes": "其它常见文生图族"
    },
    {
      "match": [
        "minimax-t2a*",
        "speech-02*",
        "speech-01*"
      ],
      "kind": "speech",
      "notes": "MiniMax T2A / speech 系列"
    },
    {
      "match": [
        "cosyvoice*",
        "sambert*"
      ],
      "kind": "speech",
      "notes": "阿里云 CosyVoice / Sambert"
    },
    {
      "match": [
        "paraformer*",
        "sensevoice*"
      ],
      "kind": "transcription",
      "notes": "阿里云 Paraformer / SenseVoice ASR"
    },
    {
      "match": [
        "gpt-4o-transcribe*",
        "gpt-4o-mini-transcribe*",
        "whisper*"
      ],
      "kind": "transcription",
      "notes": "OpenAI 转写"
    }
  ]
}
